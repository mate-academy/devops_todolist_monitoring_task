{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests (by method)",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "req/s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(todoapp_http_requests_total[5m]))",
          "legendFormat": "{{method}}"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Rate (total, 5m)",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "req/s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(todoapp_http_requests_total[5m]))", "legendFormat": "req/s" }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "App Uptime (seconds)",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ], "values": false }, "orientation": "horizontal" },
      "targets": [
        { "refId": "A", "expr": "time() - todoapp_app_start_time_seconds", "legendFormat": "uptime" }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Python GC Collections (rate, 5m)",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "1/s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (generation) (rate(python_gc_collections_total[5m]))",
          "legendFormat": "Gen {{generation}}"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Container CPU Usage (%)",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container!=\"\",container_label_com_docker_compose_service=~\"$service\"}[5m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage (MB)",
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "megabytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container!=\"\",container_label_com_docker_compose_service=~\"$service\"}) / 1024 / 1024",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["django", "prometheus", "cadvisor"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "query": "label_values(container_cpu_usage_seconds_total{container!=\"\"}, container_label_com_docker_compose_service)",
        "current": {},
        "options": []
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Django TodoApp Extended Metrics",
  "uid": null,
  "version": 1,
  "weekStart": ""
}
